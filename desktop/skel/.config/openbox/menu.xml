<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">

<menu id="root-menu" label="Openbox">
  <item label="Terminator">
    <action name="Execute"><command>terminator</command></action>
  </item>
  <item label="Files">
    <action name="Execute"><command>nemo</command></action>
  </item>
  <item label="Chrome">
    <action name="Execute"><command>google-chrome-stable</command></action>
  </item>
  <separator />
  <menu id="settings-menu" label="Settings">
    <item label="Appearance">
      <action name="Execute"><command>xfce4-appearance-settings</command></action>
    </item>
    <item label="Display">
      <action name="Execute"><command>xfce4-display-settings</command></action>
    </item>
    <item label="Keyboard">
      <action name="Execute"><command>xfce4-keyboard-settings</command></action>
    </item>
    <item label="Mouse and Touchpad">
      <action name="Execute"><command>xfce4-mouse-settings</command></action>
    </item>
    <item label="Power Manager">
      <action name="Execute"><command>xfce4-power-manager-settings</command></action>
    </item>
    <item label="Sound">
      <action name="Execute"><command>pavucontrol</command></action>
    </item>
    <item label="Window Manager">
      <action name="Execute"><command>obconf</command></action>
    </item>
  </menu>
  <separator />
  <item label="Reconfigure Openbox">
    <action name="Reconfigure" />
  </item>
  <separator />
  <item label="Lock Screen">
    <action name="Execute"><command>i3lock -c 1d2021</command></action>
  </item>
  <item label="Log Out">
    <action name="Exit" />
  </item>
  <item label="Suspend">
    <action name="Execute"><command>systemctl suspend</command></action>
  </item>
  <item label="Reboot">
    <action name="Execute"><command>systemctl reboot</command></action>
  </item>
  <item label="Shut Down">
    <action name="Execute"><command>systemctl poweroff</command></action>
  </item>
</menu>

</openbox_menu>
