<!--
  Extra Openbox key bindings for this machine, merged into the distro's
  /etc/xdg/openbox/rc.xml by desktop/install.sh.

  They are kept separate rather than shipped as a whole rc.xml on purpose:
  a full rc.xml pins the schema of one Openbox release, and a stale one
  silently loses mouse bindings and window decorations after an update.
  Merging leaves the distro file in charge of everything else.

  Note the Apple keyboard: the key next to space is Super (Mod4) in the
  default hid_apple layout, so W- bindings are the Command key.
-->
<keybindings>
  <keybind key="W-Return">
    <action name="Execute"><command>terminator</command></action>
  </keybind>
  <keybind key="W-e">
    <action name="Execute"><command>nemo</command></action>
  </keybind>
  <keybind key="W-b">
    <action name="Execute"><command>google-chrome-stable</command></action>
  </keybind>
  <keybind key="W-l">
    <action name="Execute"><command>i3lock -c 1d2021</command></action>
  </keybind>
  <keybind key="W-q">
    <action name="Close" />
  </keybind>
  <keybind key="W-f">
    <action name="ToggleFullscreen" />
  </keybind>

  <!-- Apple function row. hid_apple fnmode=1 means these arrive as media
       keys without holding Fn. -->
  <keybind key="XF86MonBrightnessUp">
    <action name="Execute"><command>brightnessctl set +5%</command></action>
  </keybind>
  <keybind key="XF86MonBrightnessDown">
    <action name="Execute"><command>brightnessctl set 5%-</command></action>
  </keybind>
  <keybind key="XF86KbdBrightnessUp">
    <action name="Execute"><command>brightnessctl -d smc::kbd_backlight set +10%</command></action>
  </keybind>
  <keybind key="XF86KbdBrightnessDown">
    <action name="Execute"><command>brightnessctl -d smc::kbd_backlight set 10%-</command></action>
  </keybind>
  <keybind key="XF86AudioRaiseVolume">
    <action name="Execute"><command>wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.0</command></action>
  </keybind>
  <keybind key="XF86AudioLowerVolume">
    <action name="Execute"><command>wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-</command></action>
  </keybind>
  <keybind key="XF86AudioMute">
    <action name="Execute"><command>wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle</command></action>
  </keybind>
  <keybind key="Print">
    <action name="Execute"><command>xfce4-screenshooter</command></action>
  </keybind>
</keybindings>
